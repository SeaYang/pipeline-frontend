{
    "apiVersion": "argoproj.io/v1alpha1",
    "kind": "WorkflowTemplate",
    "metadata": {
        "name": "go-cicd-pipeline",
        "namespace": "argo",
        "labels": {
            "app.kubernetes.io/name": "go-cicd-pipeline",
            "app.kubernetes.io/version": "0.0.1",
            "app.kubernetes.io/part-of": "pipeline",
            "kubernetes.io/os": "linux"
        },
        "annotations": {
            "app.kubernetes.io/description": "Go 应用全链路 CICD 流水线（DAG）：git-sync 拉源码并算版本元数据 → go-build 编译静态二进制 → go-build-image 用 buildkitd 打成运行镜像 tar → push-image-nexus3 用 skopeo 推送到 nexus3 → go-k8s-deploy-via-api 直调 k8s API（SSA + rollout 轮询）部署。五个子任务以 templateRef 引用 basetasktemplate 下已发布的 WorkflowTemplate，本清单只做编排与参数衔接。enenhaha"
        }
    },
    "spec": {
        "workflowMetadata": {
            "labels": {
                "app.kubernetes.io/name": "go-cicd-pipeline",
                "app.kubernetes.io/part-of": "pipeline"
            }
        },
        "serviceAccountName": "argo",
        "entrypoint": "main",
        "volumes": [{
                "name": "shared-data",
                "persistentVolumeClaim": {
                    "claimName": "nfs-pvc"
                }
            },
            {
                "name": "gitee-ssh",
                "secret": {
                    "secretName": "gitee-ssh-secret"
                }
            }
        ],
        "arguments": {
            "parameters": [{
                    "name": "app-id",
                    "default": "go-web-demo",
                    "description": "应用唯一标识；同时构成 nexus 镜像 repo 路径，且当 deploy-name 留空时作为 Deployment 名（须 DNS-1123）"
                },
                {
                    "name": "git-url",
                    "default": "git@gitee.com:awsomeyangtu/go-web-demo.git",
                    "description": "Gitee 仓库 SSH URL，如 git@gitee.com:xxx/yyy.git"
                },
                {
                    "name": "git-branch",
                    "default": "master",
                    "description": "目标构建分支"
                },
                {
                    "name": "env",
                    "value": "dev",
                    "description": "环境标识（dev/test/prod），构成镜像 repo 路径的一部分"
                },
                {
                    "name": "build-context-path",
                    "value": "cmd/server",
                    "description": "Go 主包目录（含 main）相对工作区位置；单二进制在根目录则填 ."
                },
                {
                    "name": "build-go-env",
                    "value": "CGO_ENABLED=0",
                    "description": "编译环境变量前缀，默认禁用 CGO 做静态链接（运行镜像需匹配静态二进制）"
                },
                {
                    "name": "build-go-image",
                    "value": "golang:1.26.4-alpine",
                    "description": "自带 Go 工具链的构建镜像"
                }
            ]
        },
        "templates": [{
            "name": "main",
            "dag": {
                "tasks": [{
                        "name": "git-sync",
                        "templateRef": {
                            "name": "git-sync",
                            "template": "entrypoint"
                        },
                        "arguments": {
                            "parameters": [{
                                    "name": "app-id",
                                    "value": "{{workflow.parameters.app-id}}"
                                },
                                {
                                    "name": "env",
                                    "value": "{{workflow.parameters.env}}"
                                },
                                {
                                    "name": "pipeline-run-name",
                                    "value": "{{workflow.name}}"
                                },
                                {
                                    "name": "git-url",
                                    "value": "{{workflow.parameters.git-url}}"
                                },
                                {
                                    "name": "git-branch",
                                    "value": "{{workflow.parameters.git-branch}}"
                                }
                            ]
                        }
                    },
                    {
                        "name": "go-build",
                        "depends": "git-sync",
                        "templateRef": {
                            "name": "go-build",
                            "template": "entrypoint"
                        },
                        "arguments": {
                            "parameters": [{
                                    "name": "pipeline-run-name",
                                    "value": "{{workflow.name}}"
                                },
                                {
                                    "name": "build-workspace-path",
                                    "value": "{{tasks.git-sync.outputs.parameters.build-workspace-path}}"
                                },
                                {
                                    "name": "build-context-path",
                                    "value": "{{workflow.parameters.build-context-path}}"
                                },
                                {
                                    "name": "build-go-env",
                                    "value": "{{workflow.parameters.build-go-env}}"
                                },
                                {
                                    "name": "build-artifact-name",
                                    "value": "{{tasks.git-sync.outputs.parameters.build-artifact-name}}"
                                },
                                {
                                    "name": "build-go-image",
                                    "value": "{{workflow.parameters.build-go-image}}"
                                }
                            ]
                        }
                    },
                    {
                        "name": "go-build-image",
                        "depends": "go-build",
                        "templateRef": {
                            "name": "go-build-image",
                            "template": "entrypoint"
                        },
                        "arguments": {
                            "parameters": [{
                                    "name": "pipeline-run-name",
                                    "value": "{{workflow.name}}"
                                },
                                {
                                    "name": "build-artifact-path",
                                    "value": "{{tasks.go-build.outputs.parameters.build-artifact-path}}"
                                },
                                {
                                    "name": "build-artifact-name",
                                    "value": "{{tasks.git-sync.outputs.parameters.build-artifact-name}}"
                                },
                                {
                                    "name": "build-image-name",
                                    "value": "{{workflow.parameters.app-id}}/{{workflow.parameters.env}}"
                                },
                                {
                                    "name": "build-image-tag",
                                    "value": "{{tasks.git-sync.outputs.parameters.build-artifact-name}}"
                                }
                            ]
                        }
                    },
                    {
                        "name": "push-image-nexus3",
                        "depends": "go-build-image",
                        "templateRef": {
                            "name": "push-image-nexus3",
                            "template": "entrypoint"
                        },
                        "arguments": {
                            "parameters": [{
                                    "name": "build-image-tar-path",
                                    "value": "{{tasks.go-build-image.outputs.parameters.build-image-tar-path}}"
                                },
                                {
                                    "name": "nexus-repo-name",
                                    "value": "{{workflow.parameters.app-id}}/{{workflow.parameters.env}}"
                                },
                                {
                                    "name": "nexus-image-tag",
                                    "value": "{{tasks.git-sync.outputs.parameters.build-artifact-name}}"
                                }
                            ]
                        }
                    },
                    {
                        "name": "go-k8s-deploy-via-api",
                        "depends": "push-image-nexus3",
                        "templateRef": {
                            "name": "go-k8s-deploy-via-api",
                            "template": "entrypoint"
                        },
                        "arguments": {
                            "parameters": [{
                                    "name": "image-ref",
                                    "value": "{{tasks.push-image-nexus3.outputs.parameters.nexus-image-ref}}"
                                },
                                {
                                    "name": "app-id",
                                    "value": "{{workflow.parameters.app-id}}"
                                }
                            ]
                        }
                    }
                ]
            }
        }]
    }
}